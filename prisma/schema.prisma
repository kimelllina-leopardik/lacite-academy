// Prisma Schema for G&M Group Corporate Academy
// Models the 8 core entities: User, Brand, Course, Module, Lesson, UserProgress, LearningPlan, ReminderSetting

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  EMPLOYEE
  STORE_MANAGER
  TRAINER_ADMIN
}

enum CourseCategory {
  SALES_TECHNIQUES
  BRAND_BOOK_AND_PRODUCT
  SERVICE_STANDARDS
  STORE_MANAGEMENT
}

enum ContentType {
  VIDEO
  TEXT_INFOGRAPHIC
  QUIZ
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  OVERDUE
}

model Brand {
  id          String    @id @default(cuid())
  slug        String    @unique // 'lacite', 'geox', 'yves-rocher'
  name        String    // 'lacite.tj', 'Geox', 'Yves Rocher'
  logo        String
  tagline     String?
  brandColor  String    @default("#3b82f6")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]
  courses     Course[]

  @@map("brands")
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  role         Role              @default(EMPLOYEE)
  storeId      String            // e.g. 'store-dushanbe-mall-1'
  storeName    String            @default("Флагман Dushanbe Mall")
  brandId      String
  avatarUrl    String?
  level        Int               @default(1)
  xp           Int               @default(0)
  streakDays   Int               @default(0)
  lastActiveAt DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  brand        Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  progress     UserProgress[]
  learningPlan LearningPlan?
  reminders    ReminderSetting?

  @@index([brandId])
  @@index([storeId])
  @@map("users")
}

model Course {
  id             String         @id @default(cuid())
  brandId        String?        // Nullable for universal courses (e.g. Sales Techniques)
  title          String
  description    String
  category       CourseCategory
  level          String         // 'Базовый', 'Продвинутый', 'Эксперт'
  durationMin    Int            @default(45)
  coverImage     String?
  badgeIcon      String?
  isMandatory    Boolean        @default(true)
  order          Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  brand          Brand?         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  modules        Module[]

  @@index([brandId])
  @@index([category])
  @@map("courses")
}

model Module {
  id          String    @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id           String         @id @default(cuid())
  moduleId     String
  title        String
  contentType  ContentType    @default(TEXT_INFOGRAPHIC)
  contentUrl   String?        // Video URL or Infographic asset URL
  textContent  String?        // Rich structured markdown / guidelines
  quizData     Json?          // Array of quiz questions, options, correct answers & explanations
  minPassScore Int            @default(80) // 80% passing threshold required by business rule
  duration     Int            // Duration in minutes (or seconds)
  order        Int            @default(1)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  module       Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress     UserProgress[]

  @@index([moduleId])
  @@map("lessons")
}

model UserProgress {
  id               String         @id @default(cuid())
  userId           String
  lessonId         String
  status           ProgressStatus @default(NOT_STARTED)
  quizScore        Int?           // Percentage score (0-100)
  lastPositionSec  Int            @default(0) // Saved playback or reading position
  attemptsCount    Int            @default(0)
  completedAt      DateTime?
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("user_progress")
}

model LearningPlan {
  id                 String     @id @default(cuid())
  userId             String     @unique
  title              String     // e.g., "Стажер Geox - Быстрый старт (14 дней)"
  trackType          String     // 'GEOX_INTERN', 'LACITE_PARFUM_EXPERT', 'YVES_ROCHER_ADVISOR'
  targetDate         DateTime   // Deadline
  status             PlanStatus @default(ACTIVE)
  requiredCourseIds  String[]   // List of mandatory course IDs in this plan
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_plans")
}

model ReminderSetting {
  id          String   @id @default(cuid())
  userId      String   @unique
  daysOfWeek  String[] // ["Monday", "Wednesday", "Friday"]
  timeOfDay   String   // "10:00"
  isActive    Boolean  @default(true)
  pushEnabled Boolean  @default(true)
  emailEnabled Boolean @default(false)
  pushToken   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminder_settings")
}
